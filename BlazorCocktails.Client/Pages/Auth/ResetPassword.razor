@page "/reset-password"
@attribute [AllowAnonymous]
@using API.APIService
@inject APIClient Api
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject Microsoft.Extensions.Localization.IStringLocalizer<App> L

<PageTitle>@L["Password_ResetTitle"]</PageTitle>

<MudPaper Class="auth-page--paper" Elevation="0" Square="true">
    <div class="auth-card">
        <div class="bg-gradient-auth">
            <MudText Typo="Typo.h5">@L["Password_ResetTitle"]</MudText>
        </div>

        <div class="pa-6">
            <MudForm @ref="_form">
                <MudText Class="mb-3 opacity-80">
                    @L["Password_ResetSubtitle"] <b>@_email</b>.
                </MudText>

                <MudTextField Variant="Variant.Filled"
                              T="string"
                              Label="@L["Password_ResetEmail"]"
                              Value="@_email"
                              ReadOnly="true"
                              Disabled="true"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Email" />

                <MudTextField Class="mt-4" Variant="Variant.Filled"
                              T="string"
                              Label="@L["Password_New"]"
                              @bind-Value="_newPassword"
                              InputType="@(_show1 ? InputType.Text : InputType.Password)"
                              Required="true"
                              Validation="@(new Func<string?, string?>(PasswordValidator))"
                              Disabled="@_busy"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_show1 ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _show1 = !_show1)" />

                <MudTextField Class="mt-4" Variant="Variant.Filled"
                              T="string"
                              Label="@L["Password_Confirm"]"
                              @bind-Value="_confirm"
                              InputType="@(_show2 ? InputType.Text : InputType.Password)"
                              Required="true"
                              Validation="@(new Func<string?, string?>(ConfirmValidator))"
                              Disabled="@_busy"
                              Adornment="Adornment.End"
                              AdornmentIcon="@(_show2 ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                              OnAdornmentClick="@(() => _show2 = !_show2)" />

                <MudStack Row="true" Spacing="2" Class="mt-6">
                    <MudButton Variant="Variant.Filled"
                               Class="auth-btn"
                               Disabled="@_busy"
                               OnClick="SubmitResetAsync">
                        @L["Password_Save"]
                    </MudButton>

                    <MudButton Variant="Variant.Outlined"
                               Class="auth-btn-outline"
                               Disabled="@_busy"
                               OnClick="@(() => Nav.NavigateTo("/login"))">
                        @L["Password_GoLogin"]
                    </MudButton>
                </MudStack>
            </MudForm>
        </div>
    </div>
</MudPaper>

@code {
    private MudForm? _form;
    private bool _busy, _show1, _show2;
    private string _email = "";
    private string _token = "";
    private string _newPassword = "";
    private string _confirm = "";

    protected override void OnInitialized()
    {
        // Lee y decodifica los parámetros ?email=...&token=...
        var uri = new Uri(Nav.Uri);
        var parts = uri.Query.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries);
        foreach (var p in parts)
        {
            var kv = p.Split('=', 2);
            if (kv.Length == 0) continue;
            var key = kv[0];
            var val = kv.Length > 1 ? System.Net.WebUtility.UrlDecode(kv[1]) ?? "" : "";

            if (key.Equals("email", StringComparison.OrdinalIgnoreCase)) _email = val;
            else if (key.Equals("token", StringComparison.OrdinalIgnoreCase)) _token = val;
        }
    }

    private string? PasswordValidator(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) return L["Register_PasswordRequired"];
        if (v.Length < 6) return L["Register_PasswordMin"];
        return null;
    }

    private string? ConfirmValidator(string? v)
    {
        if (string.IsNullOrWhiteSpace(v)) return L["Password_NoMatch"];
        if (!string.Equals(v, _newPassword)) return L["Password_NoMatch"];
        return null;
    }

    private async Task SubmitResetAsync()
    {
        await _form!.Validate();
        if (!_form.IsValid) return;

        _busy = true;
        try
        {
            await Api.Users_ResetPasswordAsync(new ResetPasswordDTO
            {
                Email = _email,
                Token = _token,
                NewPassword = _newPassword
            });

            Snackbar.Add(L["Password_ResetDone"], Severity.Success);
            Nav.NavigateTo("/login");
        }
        catch (ApiException<ProblemDetails> ex)
        {
            var msg = ex.Result?.Title ?? ex.Result?.Detail ?? ex.Message;
            Snackbar.Add($"{L["Password_ResetError"]}: {msg}", Severity.Error);
        }
        catch (ApiException ex)
        {
            Snackbar.Add($"{L["Password_ResetError"]}: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }
}
